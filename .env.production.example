# ============================================================================
# deploysvr 生产 .env 模板（BL-PROD-MIGRATE-DEPLOYSVR）
# ============================================================================
# 用途：docker-compose.prod.yml 的 env_file（注入 app / migrate 容器）
#       同时被 docker compose 读取用于文件内 ${...} 插值（GH_REPO / IMAGE_TAG / POSTGRES_*）。
# 落位：服务器 /opt/apps/aigc-gateway/.env（权限 600，禁止入仓）。
# 规则：本文件只放占位符/示例；真值从旧机 /opt/aigc-gateway/ecosystem.config.cjs + .env.production 读取。
# 注意：env_file 值为字面量（不做 shell 插值）；避免 POSTGRES_PASSWORD / 密钥中出现 `$`。
# ----------------------------------------------------------------------------

# ========== 镜像（compose 插值用）==========
GH_REPO=tripplemay/aigcgateway
# IMAGE_TAG 由部署流程按 git sha 注入（回滚时手动改成上一个 good sha 再 up -d）
IMAGE_TAG=latest

# ========== PostgreSQL（compose 插值 + 容器内 DATABASE_URL）==========
POSTGRES_USER=aigc
POSTGRES_DB=aigc_gateway
# 【从旧机原样迁移】旧机 DB 密码（ecosystem.config.cjs DATABASE_URL 内），或迁移时新设一个（同步改 DATABASE_URL）
POSTGRES_PASSWORD=<db-password>

# ========== 核心 ==========
NODE_ENV=production
PORT=3000

# ========== 数据库 / Redis（容器内网 service 名）==========
# 主机名用 compose 服务名 postgres / redis；密码需与上面 POSTGRES_PASSWORD 一致
DATABASE_URL=postgresql://aigc:<db-password>@postgres:5432/aigc_gateway?connection_limit=20&pool_timeout=10
REDIS_URL=redis://redis:6379/0

# ========== 认证 / 加密（全部【从旧机原样迁移】，红线 H1）==========
# ENCRYPTION_KEY 解密 DB 内 Provider.authConfig，一旦不一致全站 provider 凭据瘫痪，务必逐字复制
JWT_SECRET=<copy-from-old-machine>
JWT_EXPIRES_IN=7d
ENCRYPTION_KEY=<copy-from-old-machine>

# ========== 图片代理 HMAC（三选一，【从旧机原样迁移】）==========
# 旧机三者都设了：IMAGE_PROXY_SECRET / AUTH_SECRET / NEXTAUTH_SECRET，原样复制以保证存量签名 URL 继续有效
IMAGE_PROXY_SECRET=<copy-from-old-machine>
AUTH_SECRET=<copy-from-old-machine>
NEXTAUTH_SECRET=<copy-from-old-machine>

# ========== 图片持久化 GCS（H2 跨云凭据）==========
# 桶留在 GCP 不动；新机非 GCP，用服务账号 key 文件替代 ADC。
# key 文件落位宿主 /opt/apps/aigc-gateway/secrets/gcs-sa.json（600），compose 挂到 /app/secrets/gcs-sa.json:ro
IMAGE_PERSIST_ENABLED=true
GCS_IMAGE_BUCKET=aigc-gateway-images
GOOGLE_APPLICATION_CREDENTIALS=/app/secrets/gcs-sa.json

# ========== 域名（绝对 URL / 同源代理）==========
DOMAIN=aigc.guangai.ai
SITE_URL=https://aigc.guangai.ai
API_BASE_URL=https://aigc.guangai.ai/v1
CDN_BASE_URL=https://cdn.aigc.guangai.ai

# ========== 汇率 ==========
EXCHANGE_RATE_CNY_TO_USD=0.137

# ========== 健康检查（对齐旧机 ecosystem）==========
HEALTH_CHECK_ACTIVE_INTERVAL_MS=7200000

# ========== 日志 ==========
LOG_LEVEL=info
LOG_FORMAT=json

# ========== 出网代理（如新机访问海外服务商需要则填；直连留空）==========
# PROXY_URL_PRIMARY=socks5://proxy-host:1080
# PROXY_URL_SECONDARY=socks5://proxy2-host:1080
